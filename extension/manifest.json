{
  "manifest_version": 3,
  "name": "HyperFlow Agent",
  "version": "1.0.0",
  "description": "Local-first multi-agent browser automation",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"]
    }
  ],
  "action": {
    "default_title": "Open HyperFlow"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}

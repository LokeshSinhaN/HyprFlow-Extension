APP_NAME="Hyprflow CE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Extension Backend Port (used in docs/scripts only — artisan serve uses --port flag)
EXTENSION_PORT=8001

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Cache — file-based (no database required)
CACHE_STORE=file

# ─── AI Configuration ──────────────────────────────────────────
# At least ONE provider must be configured for the extension to work.

# Google Gemini API (Primary AI)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Request timeout in seconds (0 = no timeout)
GEMINI_REQUEST_TIMEOUT=0

# OpenAI API (Secondary AI / Fallback)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_ORGANIZATION=
# OPENAI_BASE_URL=

# Mistral API (Tertiary Fallback)
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ─── Automation Configuration ──────────────────────────────────
AUTOMATION_PRIMARY_AI=gemini
AUTOMATION_SECONDARY_AI=openai
AUTOMATION_AGENT_MAX_STEPS=50
AUTOMATION_AGENT_MAX_RETRIES=3

# ─── SSL Configuration ─────────────────────────────────────────
# Set to true to disable SSL verification for AI API calls
# WARNING: Only use this in development, never in production!
CURL_SSL_VERIFY_DISABLED=true

# ─── Back-office API Configuration ─────────────────────────────
BACKOFFICE_API_BASE_URL=https://app.medoraos.com
BACKOFFICE_API_TOKEN=
